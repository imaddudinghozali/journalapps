# ---------------------------------------------------------------------------
# Contoh .env untuk PRODUKSI
#
# .env.example adalah cetakan untuk mesin pengembangan dan sengaja dibiarkan
# longgar. Berkas ini kebalikannya. Jangan menyalin .env.example ke server.
#
# Langkah lengkapnya ada di DEPLOY.md. Nilai yang ditulis <seperti ini> harus
# kamu isi sendiri dan TIDAK BOLEH ikut masuk ke git.
# ---------------------------------------------------------------------------

APP_NAME=JournalApps
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domainmu>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug di produksi menulis isi query dan parameter ke berkas log.
LOG_LEVEL=warning

# Pengguna basis data khusus aplikasi ini, bukan root, dan haknya hanya pada
# satu basis data: SELECT, INSERT, UPDATE, DELETE, dan hak DDL untuk migrasi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=journalapps
DB_USERNAME=journalapps
DB_PASSWORD=<sandi-panjang-acak>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Verifikasi email AKTIF di aplikasi ini. Dengan MAIL_MAILER=log tidak ada
# email yang benar-benar terkirim, dan setiap pengguna baru akan berhenti
# selamanya di layar "cek emailmu" tanpa satu pun pesan galat muncul.
MAIL_MAILER=smtp
MAIL_HOST=<host-smtp>
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=<pengguna-smtp>
MAIL_PASSWORD=<sandi-smtp>
MAIL_FROM_ADDRESS="noreply@<domainmu>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
